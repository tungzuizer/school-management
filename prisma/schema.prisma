// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==================== ENUMS ====================

enum Role {
  ADMIN
  VICE_PRINCIPAL
  TEACHER
  STUDENT
}

enum AttendanceStatus {
  PRESENT
  ABSENT_EXCUSED
  ABSENT_UNEXCUSED
  LATE
}

enum GradeType {
  ORAL
  FIFTEEN_MIN
  MIDTERM
  FINAL
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  STUDYING
  TRANSFERRED
  DROPPED_OUT
  GRADUATED
}

enum ConductRating {
  TOT
  KHA
  DAT
  CHUA_DAT
}

enum AcademicRating {
  GIOI
  KHA
  DAT
  CHUA_DAT
}

enum AcademicPeriod {
  MONTH_9
  MONTH_10
  MONTH_11
  MONTH_12
  MONTH_1
  MONTH_2
  MONTH_3
  MONTH_4
  MONTH_5
  MID_HK1
  HK1
  MID_HK2
  HK2
  FULL_YEAR
}

enum IncidentType {
  VIOLATION
  COMMENDATION
}

enum ReportStatus {
  DRAFT
  SENT
}

enum SubstituteStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum WarningLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WarningCategory {
  ATTENDANCE
  DROPOUT_RISK
  PROGRESS_SLIP
  SAFETY_INCIDENT
}

// ==================== MODELS ====================

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(STUDENT)
  image     String?
  campusId  String?  // Phan hieu phu trach (cho Hieu pho)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  teacher               Teacher?
  student               Student?
  campus                Campus?  @relation(fields: [campusId], references: [id])
  sentNotifications     Notification[] @relation("SentNotifications")
  receivedNotifications Notification[] @relation("ReceivedNotifications")

  @@index([email])
  @@index([role])
  @@index([campusId])
}

model School {
  id        String   @id @default(cuid())
  name      String
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  campuses          Campus[]
  classRooms        ClassRoom[]
  academicCalendars AcademicCalendar[]

  @@index([name])
}

model Campus {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  school       School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users        User[]
  schoolPoints SchoolPoint[]
  classRooms   ClassRoom[]

  @@index([schoolId])
  @@index([name])
}

model SchoolPoint {
  id          String   @id @default(cuid())
  campusId    String
  name        String   // VD: "Điểm trung tâm", "Điểm Bản Mó", "Điểm Bản Pún", "Điểm Phia Xam"
  address     String?  // Địa chỉ / vị trí
  distanceKm  Float?   @default(0.0) // Khoảng cách tới điểm trung tâm (km)
  managerName String?  // Cán bộ / Giáo viên phụ trách điểm trường
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  campus     Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classRooms ClassRoom[]

  @@index([campusId])
  @@index([name])
}

model ClassRoom {
  id                String   @id @default(cuid())
  name              String
  gradeLevel        Int      // Khối lớp: 1-12
  schoolId          String
  campusId          String?
  schoolPointId     String?
  homeroomTeacherId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  school              School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus              Campus?             @relation(fields: [campusId], references: [id])
  schoolPoint         SchoolPoint?        @relation(fields: [schoolPointId], references: [id])
  homeroomTeacher     Teacher?            @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  students            Student[]
  groups              Group[]
  teachingAssignments TeachingAssignment[]
  attendances         Attendance[]
  schedules           Schedule[]
  incidents           Incident[]
  seatingCharts       SeatingChart[]
  dailyReports        DailyReport[]
  lessonPlans         LessonPlan[]
  journalEntries      ClassJournalEntry[]
  monthlyPlans        MonthlyPlan[]
  teacherChangeRequests TeacherChangeRequest[]

  @@index([schoolId])
  @@index([campusId])
  @@index([schoolPointId])
  @@index([gradeLevel])
  @@index([homeroomTeacherId])
}

model Group {
  id        String   @id @default(cuid())
  classId   String
  name      String   // Tổ 1, Tổ 2...
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  students  Student[]

  @@index([classId])
}

model Student {
  id          String        @id @default(cuid())
  userId      String        @unique
  studentCode String?       @unique // Mã học sinh theo CSDL ngành
  classId     String?
  groupId     String?
  status      StudentStatus @default(STUDYING)

  // Thông tin cá nhân
  dob               DateTime?
  gender            Gender?
  ethnicity         String?     // Dân tộc
  nationality       String?     // Quốc tịch
  religion          String?     // Tôn giáo
  phone             String?

  // Địa chỉ
  addressPermanent  String?     // Thường trú
  addressHometown   String?     // Quê quán
  addressCurrent    String?     // Nơi ở hiện tại

  // Đối tượng chính sách
  policyObject      String?     // Đối tượng chính sách
  disabilityType    String?     // Loại khuyết tật
  tuitionExempt     Boolean     @default(false) // Miễn học phí
  tuitionReduced    Boolean     @default(false) // Giảm học phí

  // Thông tin cha
  fatherName        String?
  fatherJob         String?
  fatherBirthYear   Int?

  // Thông tin mẹ
  motherName        String?
  motherJob         String?
  motherBirthYear   Int?

  // Thông tin người giám hộ
  guardianName      String?
  guardianJob       String?
  guardianBirthYear Int?

  // Kết quả năm trước
  priorAcademicRating String?
  priorConductRating  String?

  // Tương thích cũ
  parentName       String?
  parentPhone      String?
  parentEmail      String?
  emergencyContact String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  classRoom       ClassRoom?        @relation(fields: [classId], references: [id])
  group           Group?            @relation(fields: [groupId], references: [id])
  attendances     Attendance[]
  grades          Grade[]
  conductRecords  ConductRecord[]
  incidents       Incident[]
  parentFeedbacks ParentFeedback[]

  @@index([userId])
  @@index([classId])
  @@index([groupId])
  @@index([studentCode])
  @@index([status])
}

model Teacher {
  id        String   @id @default(cuid())
  userId    String   @unique
  specialty String?  // Chuyên môn
  phone     String?
  degree    String?  // Bằng cấp
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeroomClasses        ClassRoom[]            @relation("HomeroomTeacher")
  headSubjects           Subject[]              @relation("SubjectHead")
  teachingAssignments    TeachingAssignment[]
  schedules              Schedule[]
  lessonPlans            LessonPlan[]
  journalEntries         ClassJournalEntry[]
  requestedChanges       TeacherChangeRequest[] @relation("RequestedByTeacher")
  currentTeacherChanges  TeacherChangeRequest[] @relation("CurrentTeacherRel")
  assignedChanges        TeacherChangeRequest[] @relation("NewTeacherTarget")
  approvedChanges        TeacherChangeRequest[] @relation("HeadApprovedBy")

  @@index([userId])
}

model Subject {
  id            String   @id @default(cuid())
  name          String
  gradeLevel    Int?     // Khối lớp áp dụng (null = tất cả)
  headTeacherId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  headTeacher         Teacher?               @relation("SubjectHead", fields: [headTeacherId], references: [id], onDelete: SetNull)
  curricula           Curriculum[]
  teachingAssignments TeachingAssignment[]
  grades              Grade[]
  schedules           Schedule[]
  lessonPlans         LessonPlan[]
  journalEntries      ClassJournalEntry[]
  changeRequests      TeacherChangeRequest[]

  @@index([name])
  @@index([gradeLevel])
  @@index([headTeacherId])
}

model TeacherChangeRequest {
  id               String           @id @default(cuid())
  subjectId        String
  classId          String
  currentTeacherId String
  newTeacherId     String
  requestedById    String
  reason           String?          @db.Text
  status           SubstituteStatus @default(PENDING) // PENDING, APPROVED, CANCELLED
  approvedById     String?
  reviewNote       String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  subject        Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classRoom      ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  currentTeacher Teacher   @relation("CurrentTeacherRel", fields: [currentTeacherId], references: [id])
  newTeacher     Teacher   @relation("NewTeacherTarget", fields: [newTeacherId], references: [id])
  requestedBy    Teacher   @relation("RequestedByTeacher", fields: [requestedById], references: [id])
  approvedBy     Teacher?  @relation("HeadApprovedBy", fields: [approvedById], references: [id])

  @@index([subjectId])
  @@index([classId])
  @@index([status])
}

model Curriculum {
  id        String   @id @default(cuid())
  subjectId String
  title     String
  content   String?  @db.Text
  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
}

model TeachingAssignment {
  id        String   @id @default(cuid())
  teacherId String
  subjectId String
  classId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, classId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([classId])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  classId   String
  date      DateTime
  period    Int?             // Tiết học (1-10)
  status    AttendanceStatus @default(PRESENT)
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, date, period])
  @@index([studentId])
  @@index([classId])
  @@index([date])
  @@index([status])
}

model Grade {
  id        String    @id @default(cuid())
  studentId String
  subjectId String
  term      Int       // Học kỳ: 1 hoặc 2
  type      GradeType
  score     Float
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([subjectId])
  @@index([term])
  @@index([type])
}

model ConductRecord {
  id              String         @id @default(cuid())
  studentId       String
  period          AcademicPeriod
  conductRating   ConductRating?
  academicRating  AcademicRating?
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, period])
  @@index([studentId])
  @@index([period])
}

model Incident {
  id          String       @id @default(cuid())
  studentId   String
  classId     String
  date        DateTime
  type        IncidentType
  description String       @db.Text
  reportedBy  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([classId])
  @@index([date])
  @@index([type])
}

model ParentFeedback {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime
  channel   String?  // Kênh liên hệ: phone, email, meeting...
  content   String   @db.Text
  handledBy String?
  response  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([date])
}

model SeatingChart {
  id         String   @id @default(cuid())
  classId    String
  month      Int      // Tháng (1-12)
  year       Int      // Năm
  layoutJson String   @db.Text // JSON layout sơ đồ chỗ ngồi
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, month, year])
  @@index([classId])
}

model DailyReport {
  id                    String       @id @default(cuid())
  classId               String
  date                  DateTime
  absentCount           Int          @default(0)
  lateCount             Int          @default(0)
  incidentSummary       String?      @db.Text
  parentFeedbackSummary String?      @db.Text
  aiGeneratedText       String?      @db.Text
  editedText            String?      @db.Text
  status                ReportStatus @default(DRAFT)
  sentAt                DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, date])
  @@index([classId])
  @@index([date])
  @@index([status])
}

model Schedule {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  teacherId String
  dayOfWeek Int      // 1=Thứ 2, 2=Thứ 3, ..., 7=Chủ nhật
  period    Int      // Tiết: 1-10
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, dayOfWeek, period])
  @@unique([teacherId, dayOfWeek, period])
  @@index([classId])
  @@index([teacherId])
  @@index([dayOfWeek])
}

model Notification {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String?  // null = gửi tất cả
  title      String
  content    String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Relations
  sender   User  @relation("SentNotifications", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User? @relation("ReceivedNotifications", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// ==================== GIÁO ÁN ====================

enum LessonPlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

model LessonPlan {
  id          String           @id @default(cuid())
  teacherId   String
  subjectId   String
  classId     String
  weekNumber  Int              // Tuần thứ mấy trong năm học
  periodStart Int              // Tiết bắt đầu
  periodEnd   Int              // Tiết kết thúc
  title       String           // Tên bài / chủ đề
  objectives  String?          @db.Text // Mục tiêu bài học
  content     String?          @db.Text // Nội dung chính
  activities  String?          @db.Text // Hoạt động dạy-học
  materials   String?          @db.Text // Đồ dùng / thiết bị
  assessment  String?          @db.Text // Đánh giá
  notes       String?          @db.Text // Ghi chú / rút kinh nghiệm
  status      LessonPlanStatus @default(DRAFT)
  reviewNote  String?          @db.Text // Nhận xét của ban giám hiệu
  reviewedBy  String?
  reviewedAt  DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  // Relations
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([subjectId])
  @@index([classId])
  @@index([weekNumber])
  @@index([status])
}

// ==================== SỔ ĐẦU BÀI ====================

model ClassJournalEntry {
  id          String   @id @default(cuid())
  classId     String
  subjectId   String
  teacherId   String
  date        DateTime
  dayOfWeek   Int      // 1=Thứ 2 ... 7=CN
  period      Int      // Tiết (1-10)
  lessonTitle String?  // Tên bài dạy
  content     String?  @db.Text // Nội dung đã dạy
  absentees   String?  @db.Text // Danh sách HS vắng (JSON hoặc text)
  notes       String?  @db.Text // Nhận xét của GV
  isConfirmed Boolean  @default(false) // GVCN xác nhận
  confirmedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, date, period])
  @@index([classId])
  @@index([teacherId])
  @@index([date])
  @@index([subjectId])
}

// ==================== PHÂN CÔNG DẠY THAY & CẢNH BÁO AI ====================

model SubstituteAssignment {
  id               String           @id @default(cuid())
  originalTeacher  String           // Tên hoặc ID GV xin nghỉ
  substituteTeacher String          // Tên hoặc ID GV được phân công dạy thay
  campusName       String?          // Điểm trường / Phân hiệu
  schoolPointName  String?          // Điểm trường lẻ (nếu có)
  distanceKm       Float?           @default(0.0) // Khoảng cách di chuyển giữa 2 điểm
  className        String           // Lớp học
  subjectName      String           // Môn học
  date             DateTime         // Ngày dạy thay
  period           Int              // Tiết
  reason           String?          @db.Text // Lý do nghỉ / điều chuyển
  aiRecommendation String?          @db.Text // Đánh giá & lý do chọn của AI (tối ưu khoảng cách + chuyên môn)
  status           SubstituteStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([date])
  @@index([status])
}

model EarlyWarning {
  id              String          @id @default(cuid())
  title           String
  category        WarningCategory
  level           WarningLevel
  campusName      String?         // Phân hiệu
  schoolPointName String?         // Điểm trường lẻ (Bản Mó, Bản Pún, Phia Xam...)
  className       String?         // Lớp
  studentName     String?         // Học sinh (nếu có)
  description     String          @db.Text
  aiAnalysis      String?         @db.Text // Phân tích AI & Đề xuất hành động (cho BGH & Điểm trường)
  isResolved      Boolean         @default(false)
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([category])
  @@index([level])
  @@index([isResolved])
  @@index([createdAt])
}

model DecisionLog {
  id               String   @id @default(cuid())
  principalId      String?  // ID hoặc tên Hiệu trưởng
  query            String   @db.Text // Câu hỏi / Vấn đề cần tư vấn
  aiRecommendation String   @db.Text // Gợi ý phương án & ưu/nhược điểm từ AI
  decisionTaken    String?  @db.Text // Quyết định thực tế của Hiệu trưởng
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

// ==================== LỊCH NĂM HỌC & AI NHẮC VIỆC ====================

model AcademicCalendar {
  id         String   @id @default(cuid())
  schoolId   String
  schoolYear String   // VD: "2026-2027"
  title      String
  content    String   @db.Text  // Nội dung lịch năm học (text/markdown)
  fileUrl    String?            // Link file nếu upload
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, schoolYear])
  @@index([schoolId])
}

// ==================== KẾ HOẠCH THÁNG & NỘI DUNG SINH HOẠT TUẦN ====================

model MonthlyPlan {
  id          String   @id @default(cuid())
  classId     String
  month       Int      // 1-12
  year        Int
  planContent String?  @db.Text // Kế hoạch tháng
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  classRoom        ClassRoom        @relation(fields: [classId], references: [id], onDelete: Cascade)
  weeklyActivities WeeklyActivity[]

  @@unique([classId, month, year])
  @@index([classId])
}

model WeeklyActivity {
  id            String   @id @default(cuid())
  monthlyPlanId String
  weekNumber    Int      // Tuần 1, 2, 3, 4, 5
  content       String?  @db.Text // Nội dung sinh hoạt tuần
  notes         String?  @db.Text // Ghi chú
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  monthlyPlan MonthlyPlan @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)

  @@unique([monthlyPlanId, weekNumber])
  @@index([monthlyPlanId])
}

// ==================== BỘ CHỈ SỐ KPI TOÀN TRƯỜNG ====================

enum KpiCategory {
  STRATEGIC             // Chiến lược phát triển trường
  EDUCATIONAL_QUALITY   // Chất lượng giáo dục & Đào tạo
  PROFESSIONAL          // Công tác chuyên môn & Giảng dạy
  STAFF_PERSONNEL       // Đội ngũ cán bộ & Giáo viên
  STUDENT               // Công tác học sinh & Rèn luyện
  DIGITAL_TRANSFORMATION // Chuyển đổi số & CNTT
  FINANCIAL             // Tài chính & Ngân sách
  ASSETS                // Quản lý tài sản & Thiết bị
  FACILITIES            // Cơ sở vật chất & Hạ tầng
  SCHOOL_SAFETY         // An toàn & An ninh trường học
  SCHOOL_RELATIONS      // Quan hệ gia đình - Nhà trường - Xã hội
  INNOVATION            // Đổi mới sáng tạo & Thi đua
}

enum MeasurementDirection {
  HIGHER_BETTER
  LOWER_BETTER
  PASS_FAIL
}

enum ReportingFrequency {
  MONTHLY
  QUARTERLY
  SEMESTER
  YEARLY
}

enum KpiPeriodStatus {
  DRAFT
  SUBMITTED
  CAMPUS_CHECKED
  VP_REVIEWED
  APPROVED
  UNLOCK_REQUESTED
}

model KpiCatalog {
  id                String               @id @default(cuid())
  code              String               @unique
  name              String
  category          KpiCategory
  purpose           String?              @db.Text
  formula           String?              @db.Text
  unit              String               @default("%")
  direction         MeasurementDirection @default(HIGHER_BETTER)
  dataSource        String?
  frequency         ReportingFrequency   @default(MONTHLY)
  weight            Float                @default(0.0)
  baselineValue     Float?               @default(0.0)
  targetValue       Float?               @default(100.0)
  warningThreshold  Float?
  criticalThreshold Float?
  responsiblePerson String?
  scope             String?              @default("ALL")
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  // Relations
  assignments KpiAssignment[]
  targets     KpiTarget[]
  values      KpiValue[]

  @@index([code])
  @@index([category])
  @@index([isActive])
}

model KpiPeriod {
  id           String             @id @default(cuid())
  title        String
  year         Int
  periodType   ReportingFrequency @default(MONTHLY)
  campusId     String?
  status       KpiPeriodStatus    @default(DRAFT)
  overallScore Float?
  createdById  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // Relations
  targets      KpiTarget[]
  values       KpiValue[]
  approvalLogs KpiApprovalLog[]
  unlockLogs   KpiUnlockLog[]

  @@index([year])
  @@index([status])
  @@index([campusId])
}

model KpiAssignment {
  id          String     @id @default(cuid())
  kpiId       String
  assigneeId  String?
  campusId    String?
  weight      Float      @default(0.0)
  targetValue Float      @default(100.0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  kpi KpiCatalog @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@index([kpiId])
}

model KpiTarget {
  id          String     @id @default(cuid())
  periodId    String
  kpiId       String
  targetValue Float      @default(100.0)
  weight      Float      @default(0.0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  period KpiPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  kpi    KpiCatalog @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([periodId, kpiId])
  @@index([periodId])
  @@index([kpiId])
}

model KpiValue {
  id             String     @id @default(cuid())
  periodId       String
  kpiId          String
  actualValue    Float      @default(0.0)
  completionRate Float      @default(0.0)
  weightedScore  Float      @default(0.0)
  notes          String?    @db.Text
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  period   KpiPeriod     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  kpi      KpiCatalog    @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  evidence KpiEvidence[]

  @@unique([periodId, kpiId])
  @@index([periodId])
  @@index([kpiId])
}

model KpiEvidence {
  id          String   @id @default(cuid())
  kpiValueId  String
  title       String
  fileUrl     String?
  description String?  @db.Text
  createdAt   DateTime @default(now())

  // Relations
  kpiValue KpiValue @relation(fields: [kpiValueId], references: [id], onDelete: Cascade)

  @@index([kpiValueId])
}

model KpiApprovalLog {
  id           String          @id @default(cuid())
  periodId     String
  action       String
  fromStatus   KpiPeriodStatus
  toStatus     KpiPeriodStatus
  reviewerId   String?
  reviewerName String?
  comments     String?         @db.Text
  createdAt    DateTime        @default(now())

  // Relations
  period KpiPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([createdAt])
}

model KpiUnlockLog {
  id             String   @id @default(cuid())
  periodId       String
  requestedById  String?
  requestedByName String?
  reason         String   @db.Text
  approvedById   String?
  approvedByName String?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  period KpiPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([status])
}

// ==================== MỤC TIÊU CHẤT LƯỢNG (QUALITY OBJECTIVES) ====================

enum QualityCategory {
  ACADEMIC                  // 1. Chất lượng học tập
  CONDUCT                   // 2. Phẩm chất và năng lực học sinh
  ATTENDANCE                // 3. Chuyên cần
  PROGRAM_COMPLETION        // 4. Tỷ lệ hoàn thành chương trình
  EXCELLENT_STUDENTS        // 5. Học sinh giỏi
  SUPPORT_STUDENTS          // 6. Học sinh cần hỗ trợ
  TEACHER_QUALITY           // 7. Chất lượng đội ngũ
  DIGITAL_TRANSFORMATION    // 8. Chuyển đổi số
  FACILITIES                // 9. Cơ sở vật chất
  SCHOOL_SAFETY             // 10. An toàn trường học
  PARENT_SATISFACTION       // 11. Sự hài lòng của cha mẹ học sinh
  OTHER                     // 12. Mục tiêu khác
}

enum QualityObjectiveStatus {
  EXCEEDED          // Vượt mục tiêu
  ACHIEVED          // Đạt
  NEAR_TARGET       // Gần đạt (80% - <100%)
  AT_RISK           // Có nguy cơ không đạt (60% - <80%)
  FAILED            // Không đạt (<60%)
  NO_DATA           // Chưa có dữ liệu
}

model QualityObjective {
  id                  String                 @id @default(cuid())
  code                String                 @unique
  title               String
  category            QualityCategory        @default(ACADEMIC)
  metricName          String                 // Chỉ số đo lường
  unit                String                 @default("%")
  baselineValue       Float?                 @default(0.0)
  targetValue         Float                  @default(100.0)
  actualValue         Float?                 @default(0.0)
  direction           MeasurementDirection   @default(HIGHER_BETTER)
  minRange            Float?
  maxRange            Float?
  deadline            DateTime?
  period              ReportingFrequency     @default(SEMESTER)
  responsiblePerson   String?
  dataSource          String?                // Nguồn dữ liệu kiểm chứng
  reportingFrequency  ReportingFrequency     @default(MONTHLY)
  campusScope         String                 @default("ALL") // ALL hoặc campusId
  academicYear        String                 @default("2026-2027")
  status              QualityObjectiveStatus @default(NO_DATA)
  completionRate      Float                  @default(0.0)
  actionPlan          String?                @db.Text
  campusBreakdownJson String?                @db.Text // JSON chi tiết theo phân hiệu
  notes               String?                @db.Text
  createdById         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  // Relations
  evidences QualityObjectiveEvidence[]
  histories QualityObjectiveHistory[]

  @@index([code])
  @@index([category])
  @@index([status])
  @@index([academicYear])
  @@index([campusScope])
}

// ==================== QUY TRÌNH PHÊ DUYỆT & KHÓA DỮ LIỆU ====================

model ApprovalWorkflow {
  id              String            @id @default(cuid())
  schoolId        String?
  moduleName      String            // VD: "STRATEGY_KPI", "QUALITY_OBJECTIVE", "LESSON_PLAN", "MONTHLY_PLAN"
  recordId        String            // ID của record trong module tương ứng
  title           String            // Tên hồ sơ / mục tiêu / kế hoạch
  campusId        String?
  currentStep     Int               @default(1) // 1: Draft, 2: Submitted, 3: Campus Confirmed, 4: VP Reviewed, 5: Principal Approved, 6: Locked
  currentStatus   String            @default("DRAFT") // DRAFT, SUBMITTED, CAMPUS_CONFIRMED, VP_REVIEWED, PRINCIPAL_APPROVED, LOCKED, REJECTED, EDIT_REQUESTED, UNLOCK_REQUESTED
  submittedBy     String?
  submittedByName String?
  submittedAt     DateTime?
  reviewedBy      String?
  reviewedByName  String?
  reviewedAt      DateTime?
  approvedBy      String?
  approvedByName  String?
  approvedAt      DateTime?
  rejectionReason String?           @db.Text
  isLocked        Boolean           @default(false)
  lockedAt        DateTime?
  version         Int               @default(1)
  dueDate         DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  comments ApprovalComment[]

  @@index([moduleName, recordId])
  @@index([currentStatus])
  @@index([campusId])
  @@index([isLocked])
}

model ApprovalComment {
  id             String           @id @default(cuid())
  workflowId     String
  userId         String?
  userName       String?
  userRole       String?
  commentType    String           @default("COMMENT") // COMMENT, REJECT, REQUEST_EDIT, APPROVE, UNLOCK_REQUEST
  commentContent String           @db.Text
  attachmentUrl  String?
  createdAt      DateTime         @default(now())

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([createdAt])
}

// ==================== TỆP MINH CHỨNG & NHẬT KÝ FILE ====================

model SystemEvidenceFile {
  id             String          @id @default(cuid())
  fileName       String
  fileType       String          // pdf, docx, xlsx, png, jpg, jpeg
  fileSize       Int             // Kích thước (bytes)
  fileUrl        String          @db.Text
  uploadedById   String?
  uploadedByName String          @default("Cán bộ quản lý")
  relatedModule  String          // VD: "QUALITY_OBJECTIVE", "STRATEGY_KPI", "FIVE_YEAR_PLAN"
  relatedRecordId String?        // ID mục tiêu hoặc KPI liên quan
  relatedContent String?         @db.Text // Tên mục tiêu / nội dung liên quan
  campusId       String?
  description    String?         @db.Text
  version        Int             @default(1)
  status         String          @default("ACTIVE") // ACTIVE, REPLACED, DELETED
  isDeleted      Boolean         @default(false) // Xóa mềm
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  auditLogs FileAuditLog[]

  @@index([relatedModule])
  @@index([campusId])
  @@index([isDeleted])
  @@index([createdAt])
}

model FileAuditLog {
  id         String             @id @default(cuid())
  fileId     String
  action     String             // UPLOAD, REPLACE, SOFT_DELETE, RESTORE, DOWNLOAD
  performedById String?
  performedByName String        @default("Hệ thống")
  detail     String?            @db.Text
  createdAt  DateTime           @default(now())

  file SystemEvidenceFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([createdAt])
}

model QualityObjectiveEvidence {
  id          String   @id @default(cuid())
  objectiveId String
  title       String
  fileUrl     String?
  uploadedBy  String?
  description String?  @db.Text
  createdAt   DateTime @default(now())

  // Relations
  objective QualityObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([objectiveId])
}

model QualityObjectiveHistory {
  id             String                 @id @default(cuid())
  objectiveId    String
  updatedByName  String?
  previousActual Float?
  newActual      Float
  completionRate Float
  status         QualityObjectiveStatus @default(NO_DATA)
  note           String?                @db.Text
  createdAt      DateTime               @default(now())

  // Relations
  objective QualityObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([objectiveId])
  @@index([createdAt])
}
