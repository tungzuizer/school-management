// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==================== ENUMS ====================

enum Role {
  SUPER_ADMIN       // System Admin — infra only, no academic data
  DEPARTMENT_ADMIN  // Sở GD&ĐT — aggregate read for all schools under department
  DISTRICT_ADMIN    // Phòng GD&ĐT — aggregate read for schools in district
  WARD_ADMIN        // UBND Xã (commune) — read-only statistics for campuses in ward
  ADMIN             // Hiệu trưởng — full access across all campuses of the school
  VICE_PRINCIPAL    // Phó Hiệu trưởng — full access within assigned campus only
  SUBJECT_HEAD      // Tổ trưởng chuyên môn — cross-campus access scoped to subject group
  TEACHER
  STUDENT
}

enum ScopeType {
  GLOBAL        // Unrestricted (SUPER_ADMIN, DEPARTMENT_ADMIN)
  CAMPUS        // Scoped to a single campus (VICE_PRINCIPAL)
  SUBJECT_GROUP // Scoped to a subject group across all campuses (SUBJECT_HEAD)
  WARD          // Scoped to a geographic ward (WARD_ADMIN)
}

enum ManagementBranch {
  WARD
  THPT
}

enum SchoolType {
  TIEU_HOC
  THCS
  THPT
  LIEN_CAP
}

enum AttendanceStatus {
  PRESENT
  ABSENT_EXCUSED
  ABSENT_UNEXCUSED
  LATE
}

enum GradeType {
  ORAL
  FIFTEEN_MIN
  MIDTERM
  FINAL
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  STUDYING
  TRANSFERRED
  DROPPED_OUT
  GRADUATED
}

enum ConductRating {
  TOT
  KHA
  DAT
  CHUA_DAT
}

enum AcademicRating {
  GIOI
  KHA
  DAT
  CHUA_DAT
}

enum AcademicPeriod {
  MONTH_9
  MONTH_10
  MONTH_11
  MONTH_12
  MONTH_1
  MONTH_2
  MONTH_3
  MONTH_4
  MONTH_5
  MID_HK1
  HK1
  MID_HK2
  HK2
  FULL_YEAR
}

enum IncidentType {
  VIOLATION
  COMMENDATION
}

enum ReportStatus {
  DRAFT
  SENT
}

enum SubstituteStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum WarningLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum WarningCategory {
  ATTENDANCE
  DROPOUT_RISK
  PROGRESS_SLIP
  SAFETY_INCIDENT
}

// ==================== MODELS ====================

model EducationDepartment {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  address   String?
  phone     String?
  email     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  districtWards DistrictWard[]
  schools       School[]
  users         User[]

  @@index([name])
}

model DistrictWard {
  id           String   @id @default(cuid())
  departmentId String
  name         String
  code         String?
  address      String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  department EducationDepartment @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  schools    School[]
  users      User[]
  campusMaps CampusWardMap[]

  @@index([departmentId])
  @@index([name])
}

model User {
  id             String   @id @default(cuid())
  name           String
  email          String   @unique
  password       String
  role           Role     @default(STUDENT)
  isApproved     Boolean  @default(true)
  image          String?
  departmentId   String?
  districtWardId String?
  schoolId       String?
  campusId            String?
  mustChangePassword  Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  department            EducationDepartment? @relation(fields: [departmentId], references: [id])
  districtWard          DistrictWard?        @relation(fields: [districtWardId], references: [id])
  school                School?              @relation(fields: [schoolId], references: [id])
  teacher               Teacher?
  student               Student?
  campus                Campus?              @relation(fields: [campusId], references: [id])
  userRoleScopes        UserRoleScope[]
  sentNotifications     Notification[]       @relation("SentNotifications")
  receivedNotifications Notification[]       @relation("ReceivedNotifications")

  @@index([email])
  @@index([role])
  @@index([departmentId])
  @@index([districtWardId])
  @@index([schoolId])
  @@index([campusId])
}

model UserRoleScope {
  id             String    @id @default(cuid())
  userId         String
  role           Role
  scopeType      ScopeType
  scopeId        String?   // campusId OR wardId depending on scopeType
  subjectGroupId String?   // for SUBJECT_HEAD: the subject group they manage
  createdAt      DateTime  @default(now())

  // Relations
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectGroup SubjectGroup? @relation(fields: [subjectGroupId], references: [id], onDelete: Cascade)

  @@unique([userId, role, scopeId, subjectGroupId])
  @@index([userId])
  @@index([role])
  @@index([subjectGroupId])
}

model CampusWardMap {
  campusId String
  wardId   String

  // Relations
  campus Campus       @relation(fields: [campusId], references: [id], onDelete: Cascade)
  ward   DistrictWard @relation(fields: [wardId], references: [id], onDelete: Cascade)

  @@id([campusId, wardId])
  @@index([campusId])
  @@index([wardId])
}

model School {
  id             String           @id @default(cuid())
  departmentId   String?
  districtWardId String?
  branchType     ManagementBranch @default(WARD)
  schoolType     SchoolType       @default(THCS)
  name           String
  address        String?
  phone          String?
  email          String?
  sharedDriveUrl String?          // Link Google Drive dùng chung cho trường
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  // Relations
  department          EducationDepartment? @relation(fields: [departmentId], references: [id])
  districtWard        DistrictWard?        @relation(fields: [districtWardId], references: [id])
  users               User[]
  campuses            Campus[]
  classRooms          ClassRoom[]
  academicCalendars   AcademicCalendar[]
  subjectGroups       SubjectGroup[]
  lessonPlanPeriods   LessonPlanPeriod[]
  aiConfigThresholds  AiConfigThreshold[]
  aiAlerts            AiAlert[]
  aiRecommendations   AiRecommendation[]
  aiReportSummaries   AiReportSummary[]
  aiAnalysisLogs      AiAnalysisLog[]
  officialDocuments   OfficialDocument[]
  equipmentItems      Equipment[]
  journeySnapshots        StudentJourneySnapshot[]
  journeyThresholdConfigs JourneyThresholdConfig[]
  examPeriods             ExamPeriod[]
  studentScores           StudentScore[]
  importBatches           StudentImportBatch[]

  @@index([name])
  @@index([departmentId])
  @@index([districtWardId])
  @@index([branchType])
}

model Campus {
  id        String   @id @default(cuid())
  schoolId  String
  name      String
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  school            School            @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  users             User[]
  schoolPoints      SchoolPoint[]
  classRooms        ClassRoom[]
  wardMaps          CampusWardMap[]
  aiAlerts          AiAlert[]
  aiRecommendations AiRecommendation[]
  aiReportSummaries AiReportSummary[]
  officialDocuments OfficialDocument[]
  equipmentItems    Equipment[]
  journeySnapshots        StudentJourneySnapshot[]
  journeyThresholdConfigs JourneyThresholdConfig[]
  examPeriods             ExamPeriod[]
  studentScores           StudentScore[]

  @@index([schoolId])
  @@index([name])
}

model SchoolPoint {
  id          String   @id @default(cuid())
  campusId    String
  name        String   // VD: "Điểm trung tâm", "Điểm Bản Mó", "Điểm Bản Pún", "Điểm Phia Xam"
  address     String?  // Địa chỉ / vị trí
  distanceKm  Float?   @default(0.0) // Khoảng cách tới điểm trung tâm (km)
  managerName String?  // Cán bộ / Giáo viên phụ trách điểm trường
  phone       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  campus            Campus              @relation(fields: [campusId], references: [id], onDelete: Cascade)
  classRooms        ClassRoom[]
  aiAlerts          AiAlert[]
  aiRecommendations AiRecommendation[]
  equipmentItems    Equipment[]
  transfersFrom     EquipmentTransfer[] @relation("TransferSourcePoint")
  transfersTo       EquipmentTransfer[] @relation("TransferTargetPoint")

  @@index([campusId])
  @@index([name])
}

model ClassRoom {
  id                String   @id @default(cuid())
  name              String
  gradeLevel        Int      // Khối lớp: 1-12
  schoolId          String
  campusId          String?
  schoolPointId     String?
  homeroomTeacherId String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  // Relations
  school              School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus              Campus?             @relation(fields: [campusId], references: [id])
  schoolPoint         SchoolPoint?        @relation(fields: [schoolPointId], references: [id])
  homeroomTeacher     Teacher?            @relation("HomeroomTeacher", fields: [homeroomTeacherId], references: [id])
  students            Student[]
  groups              Group[]
  teachingAssignments TeachingAssignment[]
  attendances         Attendance[]
  schedules           Schedule[]
  incidents           Incident[]
  seatingCharts       SeatingChart[]
  dailyReports        DailyReport[]
  lessonPlans         LessonPlan[]
  journalEntries      ClassJournalEntry[]
  monthlyPlans        MonthlyPlan[]
  academicTranscripts AcademicTranscript[]
  teacherChangeRequests TeacherChangeRequest[]
  participations      ParticipationRecord[]

  @@index([schoolId])
  @@index([campusId])
  @@index([schoolPointId])
  @@index([gradeLevel])
  @@index([homeroomTeacherId])
}

model Group {
  id        String   @id @default(cuid())
  classId   String
  name      String   // Tổ 1, Tổ 2...
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  students  Student[]

  @@index([classId])
}

model Student {
  id          String        @id @default(cuid())
  userId      String        @unique
  studentCode String?       @unique // Mã học sinh theo CSDL ngành
  classId     String?
  groupId     String?
  status      StudentStatus @default(STUDYING)
  isClassMonitor Boolean    @default(false) // Lớp trưởng
  classRole   String?       // "LOP_TRUONG", "LOP_PHO", "TO_TRUONG", "THANH_VIEN"
  bonusPoints Int           @default(0) // Tổng điểm tích cực/thưởng

  // Thông tin cá nhân
  dob               DateTime?
  gender            Gender?
  ethnicity         String?     // Dân tộc
  nationality       String?     // Quốc tịch
  religion          String?     // Tôn giáo
  phone             String?

  // Địa chỉ
  addressPermanent  String?     // Thường trú
  addressHometown   String?     // Quê quán
  addressCurrent    String?     // Nơi ở hiện tại

  // Đối tượng chính sách
  policyObject      String?     // Đối tượng chính sách
  disabilityType    String?     // Loại khuyết tật
  tuitionExempt     Boolean     @default(false) // Miễn học phí
  tuitionReduced    Boolean     @default(false) // Giảm học phí

  // Thông tin cha
  fatherName        String?
  fatherJob         String?
  fatherBirthYear   Int?

  // Thông tin mẹ
  motherName        String?
  motherJob         String?
  motherBirthYear   Int?

  // Thông tin người giám hộ
  guardianName      String?
  guardianJob       String?
  guardianBirthYear Int?

  // Kết quả năm trước
  priorAcademicRating String?
  priorConductRating  String?

  // Tương thích cũ
  parentName       String?
  parentPhone      String?
  parentEmail      String?
  emergencyContact String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user            User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  classRoom       ClassRoom?        @relation(fields: [classId], references: [id])
  group           Group?            @relation(fields: [groupId], references: [id])
  attendances     Attendance[]
  grades          Grade[]
  conductRecords  ConductRecord[]
  incidents       Incident[]
  parentFeedbacks ParentFeedback[]
  academicTranscripts AcademicTranscript[]
  participations  ParticipationRecord[]
  journeySnapshots StudentJourneySnapshot[]
  interventions    InterventionRecord[]
  studentScores    StudentScore[]

  @@index([userId])
  @@index([classId])
  @@index([groupId])
  @@index([studentCode])
  @@index([status])
}

model Teacher {
  id        String   @id @default(cuid())
  userId    String   @unique
  specialty String?  // Chuyên môn
  phone     String?
  degree    String?  // Bằng cấp
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user                   User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  homeroomClasses        ClassRoom[]            @relation("HomeroomTeacher")
  headSubjects           Subject[]              @relation("SubjectHead")
  headSubjectGroups      SubjectGroup[]         @relation("SubjectGroupHead")
  teachingAssignments    TeachingAssignment[]
  schedules              Schedule[]
  lessonPlans            LessonPlan[]
  journalEntries         ClassJournalEntry[]
  requestedChanges       TeacherChangeRequest[] @relation("RequestedByTeacher")
  currentTeacherChanges  TeacherChangeRequest[] @relation("CurrentTeacherRel")
  assignedChanges        TeacherChangeRequest[] @relation("NewTeacherTarget")
  approvedChanges        TeacherChangeRequest[] @relation("HeadApprovedBy")

  @@index([userId])
}

model Subject {
  id             String   @id @default(cuid())
  name           String
  gradeLevel     Int?     // Khối lớp áp dụng (null = tất cả)
  headTeacherId  String?
  subjectGroupId String?  // Thuộc tổ chuyên môn nào
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  headTeacher         Teacher?               @relation("SubjectHead", fields: [headTeacherId], references: [id], onDelete: SetNull)
  subjectGroup        SubjectGroup?          @relation(fields: [subjectGroupId], references: [id], onDelete: SetNull)
  curricula           Curriculum[]
  teachingAssignments TeachingAssignment[]
  grades              Grade[]
  schedules           Schedule[]
  lessonPlans         LessonPlan[]
  journalEntries      ClassJournalEntry[]
  changeRequests      TeacherChangeRequest[]
  transcriptSubjectGrades TranscriptSubjectGrade[]
  journeySnapshots    StudentJourneySnapshot[]
  studentScores       StudentScore[]

  @@index([name])
  @@index([gradeLevel])
  @@index([headTeacherId])
  @@index([subjectGroupId])
}

// Tổ Chuyên Môn (VD: Tổ Tự nhiên, Tổ Xã hội, Tổ Ngoại ngữ)
model SubjectGroup {
  id            String   @id @default(cuid())
  schoolId      String
  name          String       // "Tổ Tự nhiên", "Tổ Xã hội"...
  headTeacherId String?      // Tổ trưởng chuyên môn
  description   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  school      School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  headTeacher Teacher?  @relation("SubjectGroupHead", fields: [headTeacherId], references: [id], onDelete: SetNull)
  subjects        Subject[]
  userRoleScopes  UserRoleScope[]

  @@index([schoolId])
  @@index([headTeacherId])
}

// Kỳ nộp giáo án (hàng tháng hoặc đầu kỳ)
model LessonPlanPeriod {
  id        String   @id @default(cuid())
  schoolId  String
  label     String       // "Tháng 9/2025", "HK1 2025-2026"
  startDate DateTime
  deadline  DateTime     // Hạn cuối nộp giáo án
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  school      School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  lessonPlans LessonPlan[]

  @@index([schoolId])
  @@index([deadline])
  @@index([isActive])
}

model TeacherChangeRequest {
  id               String           @id @default(cuid())
  subjectId        String
  classId          String
  currentTeacherId String
  newTeacherId     String
  requestedById    String
  reason           String?          @db.Text
  status           SubstituteStatus @default(PENDING) // PENDING, APPROVED, CANCELLED
  approvedById     String?
  reviewNote       String?          @db.Text
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  subject        Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classRoom      ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  currentTeacher Teacher   @relation("CurrentTeacherRel", fields: [currentTeacherId], references: [id])
  newTeacher     Teacher   @relation("NewTeacherTarget", fields: [newTeacherId], references: [id])
  requestedBy    Teacher   @relation("RequestedByTeacher", fields: [requestedById], references: [id])
  approvedBy     Teacher?  @relation("HeadApprovedBy", fields: [approvedById], references: [id])

  @@index([subjectId])
  @@index([classId])
  @@index([status])
}

model Curriculum {
  id        String   @id @default(cuid())
  subjectId String
  title     String
  content   String?  @db.Text
  fileUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([subjectId])
}

model TeachingAssignment {
  id        String   @id @default(cuid())
  teacherId String
  subjectId String
  classId   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([teacherId, subjectId, classId])
  @@index([teacherId])
  @@index([subjectId])
  @@index([classId])
}

model Attendance {
  id        String           @id @default(cuid())
  studentId String
  classId   String
  date      DateTime
  period    Int?             // Tiết học (1-10)
  status    AttendanceStatus @default(PRESENT)
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  // Relations
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([studentId, classId, date, period])
  @@index([studentId])
  @@index([classId])
  @@index([date])
  @@index([status])
}

model Grade {
  id        String    @id @default(cuid())
  studentId String
  subjectId String
  term      Int       // Học kỳ: 1 hoặc 2
  type      GradeType
  score     Float
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([subjectId])
  @@index([term])
  @@index([type])
}

model ConductRecord {
  id              String         @id @default(cuid())
  studentId       String
  period          AcademicPeriod
  conductRating   ConductRating?
  academicRating  AcademicRating?
  note            String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, period])
  @@index([studentId])
  @@index([period])
}

model Incident {
  id          String       @id @default(cuid())
  studentId   String
  classId     String
  date        DateTime
  type        IncidentType
  description String       @db.Text
  reportedBy  String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([classId])
  @@index([date])
  @@index([type])
}

model ParentFeedback {
  id        String   @id @default(cuid())
  studentId String
  date      DateTime
  channel   String?  // Kênh liên hệ: phone, email, meeting...
  content   String   @db.Text
  handledBy String?
  response  String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([date])
}

model SeatingChart {
  id         String   @id @default(cuid())
  classId    String
  month      Int      // Tháng (1-12)
  year       Int      // Năm
  layoutJson String   @db.Text // JSON layout sơ đồ chỗ ngồi
  version    Int      @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, month, year])
  @@index([classId])
}

model DailyReport {
  id                    String       @id @default(cuid())
  classId               String
  date                  DateTime
  absentCount           Int          @default(0)
  lateCount             Int          @default(0)
  incidentSummary       String?      @db.Text
  parentFeedbackSummary String?      @db.Text
  aiGeneratedText       String?      @db.Text
  editedText            String?      @db.Text
  status                ReportStatus @default(DRAFT)
  sentAt                DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  // Relations
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, date])
  @@index([classId])
  @@index([date])
  @@index([status])
}

model Schedule {
  id        String   @id @default(cuid())
  classId   String
  subjectId String
  teacherId String
  dayOfWeek Int      // 1=Thứ 2, 2=Thứ 3, ..., 7=Chủ nhật
  period    Int      // Tiết: 1-10
  room      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, dayOfWeek, period])
  @@unique([teacherId, dayOfWeek, period])
  @@index([classId])
  @@index([teacherId])
  @@index([dayOfWeek])
}

model Notification {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String?  // null = gửi tất cả
  title      String
  content    String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  // Relations
  sender   User  @relation("SentNotifications", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User? @relation("ReceivedNotifications", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// ==================== GIÁO ÁN ====================

enum LessonPlanStatus {
  DRAFT
  SUBMITTED
  HEAD_APPROVED    // Tổ trưởng chuyên môn đã duyệt
  HEAD_REJECTED    // Tổ trưởng chuyên môn từ chối
  VP_APPROVED      // Phó Hiệu trưởng đã duyệt
  VP_REJECTED      // Phó Hiệu trưởng từ chối
  APPROVED         // Hiệu trưởng phê duyệt cuối cùng
  REJECTED         // Hiệu trưởng từ chối
}

model LessonPlan {
  id           String           @id @default(cuid())
  teacherId    String
  subjectId    String
  classId      String
  periodId     String?          // Kỳ nộp giáo án
  weekNumber   Int              // Tuần thứ mấy trong năm học
  periodStart  Int              // Tiết bắt đầu
  periodEnd    Int              // Tiết kết thúc
  title        String           // Tên bài / chủ đề
  objectives   String?          @db.Text // Mục tiêu bài học
  content      String?          @db.Text // Nội dung chính
  activities   String?          @db.Text // Hoạt động dạy-học
  materials    String?          @db.Text // Đồ dùng / thiết bị
  assessment   String?          @db.Text // Đánh giá
  notes        String?          @db.Text // Ghi chú / rút kinh nghiệm
  driveFileUrl String?          // Link file giáo án trên Google Drive
  status       LessonPlanStatus @default(DRAFT)
  reviewNote   String?          @db.Text // Nhận xét của ban giám hiệu
  reviewedBy   String?
  reviewedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Relations
  teacher   Teacher            @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  subject   Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  classRoom ClassRoom          @relation(fields: [classId], references: [id], onDelete: Cascade)
  period    LessonPlanPeriod?  @relation(fields: [periodId], references: [id], onDelete: SetNull)
  reviews   LessonPlanReview[]

  @@index([teacherId])
  @@index([subjectId])
  @@index([classId])
  @@index([periodId])
  @@index([weekNumber])
  @@index([status])
}

// Lịch sử phê duyệt giáo án (mỗi bước duyệt tạo 1 bản ghi)
model LessonPlanReview {
  id           String           @id @default(cuid())
  lessonPlanId String
  reviewerName String           // Họ tên người duyệt
  reviewerRole String           // "SUBJECT_HEAD", "VICE_PRINCIPAL", "ADMIN"
  action       LessonPlanStatus // Trạng thái sau khi duyệt
  comment      String?          @db.Text // Nhận xét
  createdAt    DateTime         @default(now())

  // Relations
  lessonPlan LessonPlan @relation(fields: [lessonPlanId], references: [id], onDelete: Cascade)

  @@index([lessonPlanId])
  @@index([createdAt])
}

// ==================== SỔ ĐẦU BÀI ====================

model ClassJournalEntry {
  id          String   @id @default(cuid())
  classId     String
  subjectId   String
  teacherId   String
  date        DateTime
  dayOfWeek   Int      // 1=Thứ 2 ... 7=CN
  period      Int      // Tiết (1-10)
  lessonTitle String?  // Tên bài dạy
  content     String?  @db.Text // Nội dung đã dạy
  absentees   String?  @db.Text // Danh sách HS vắng (JSON hoặc text)
  notes       String?  @db.Text // Nhận xét của GV
  isConfirmed Boolean  @default(false) // GVCN xác nhận
  confirmedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)
  subject   Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher   Teacher   @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, date, period])
  @@index([classId])
  @@index([teacherId])
  @@index([date])
  @@index([subjectId])
}

// ==================== PHÂN CÔNG DẠY THAY & CẢNH BÁO AI ====================

model SubstituteAssignment {
  id               String           @id @default(cuid())
  originalTeacher  String           // Tên hoặc ID GV xin nghỉ
  substituteTeacher String          // Tên hoặc ID GV được phân công dạy thay
  campusName       String?          // Điểm trường / Phân hiệu
  schoolPointName  String?          // Điểm trường lẻ (nếu có)
  distanceKm       Float?           @default(0.0) // Khoảng cách di chuyển giữa 2 điểm
  className        String           // Lớp học
  subjectName      String           // Môn học
  date             DateTime         // Ngày dạy thay
  period           Int              // Tiết
  reason           String?          @db.Text // Lý do nghỉ / điều chuyển
  aiRecommendation String?          @db.Text // Đánh giá & lý do chọn của AI (tối ưu khoảng cách + chuyên môn)
  status           SubstituteStatus @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@index([date])
  @@index([status])
}

model EarlyWarning {
  id              String          @id @default(cuid())
  title           String
  category        WarningCategory
  level           WarningLevel
  campusName      String?         // Phân hiệu
  schoolPointName String?         // Điểm trường lẻ (Bản Mó, Bản Pún, Phia Xam...)
  className       String?         // Lớp
  studentName     String?         // Học sinh (nếu có)
  description     String          @db.Text
  aiAnalysis      String?         @db.Text // Phân tích AI & Đề xuất hành động (cho BGH & Điểm trường)
  isResolved      Boolean         @default(false)
  resolvedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([category])
  @@index([level])
  @@index([isResolved])
  @@index([createdAt])
}

model DecisionLog {
  id               String   @id @default(cuid())
  principalId      String?  // ID hoặc tên Hiệu trưởng
  query            String   @db.Text // Câu hỏi / Vấn đề cần tư vấn
  aiRecommendation String   @db.Text // Gợi ý phương án & ưu/nhược điểm từ AI
  decisionTaken    String?  @db.Text // Quyết định thực tế của Hiệu trưởng
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

// ==================== LỊCH NĂM HỌC & AI NHẮC VIỆC ====================

model AcademicCalendar {
  id         String   @id @default(cuid())
  schoolId   String
  schoolYear String   // VD: "2026-2027"
  title      String
  content    String   @db.Text  // Nội dung lịch năm học (text/markdown)
  fileUrl    String?            // Link file nếu upload
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  school School @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, schoolYear])
  @@index([schoolId])
}

// ==================== KẾ HOẠCH THÁNG & NỘI DUNG SINH HOẠT TUẦN ====================

model MonthlyPlan {
  id          String   @id @default(cuid())
  classId     String
  month       Int      // 1-12
  year        Int
  planContent String?  @db.Text // Kế hoạch tháng
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  classRoom        ClassRoom        @relation(fields: [classId], references: [id], onDelete: Cascade)
  weeklyActivities WeeklyActivity[]

  @@unique([classId, month, year])
  @@index([classId])
}

model WeeklyActivity {
  id            String   @id @default(cuid())
  monthlyPlanId String
  weekNumber    Int      // Tuần 1, 2, 3, 4, 5
  content       String?  @db.Text // Nội dung sinh hoạt tuần
  notes         String?  @db.Text // Ghi chú
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  monthlyPlan MonthlyPlan @relation(fields: [monthlyPlanId], references: [id], onDelete: Cascade)

  @@unique([monthlyPlanId, weekNumber])
  @@index([monthlyPlanId])
}

// ==================== BỘ CHỈ SỐ KPI TOÀN TRƯỜNG ====================

enum KpiCategory {
  STRATEGIC             // Chiến lược phát triển trường
  EDUCATIONAL_QUALITY   // Chất lượng giáo dục & Đào tạo
  PROFESSIONAL          // Công tác chuyên môn & Giảng dạy
  STAFF_PERSONNEL       // Đội ngũ cán bộ & Giáo viên
  STUDENT               // Công tác học sinh & Rèn luyện
  DIGITAL_TRANSFORMATION // Chuyển đổi số & CNTT
  FINANCIAL             // Tài chính & Ngân sách
  ASSETS                // Quản lý tài sản & Thiết bị
  FACILITIES            // Cơ sở vật chất & Hạ tầng
  SCHOOL_SAFETY         // An toàn & An ninh trường học
  SCHOOL_RELATIONS      // Quan hệ gia đình - Nhà trường - Xã hội
  INNOVATION            // Đổi mới sáng tạo & Thi đua
}

enum MeasurementDirection {
  HIGHER_BETTER
  LOWER_BETTER
  PASS_FAIL
}

enum ReportingFrequency {
  MONTHLY
  QUARTERLY
  SEMESTER
  YEARLY
}

enum KpiPeriodStatus {
  DRAFT
  SUBMITTED
  CAMPUS_CHECKED
  VP_REVIEWED
  APPROVED
  UNLOCK_REQUESTED
}

model KpiCatalog {
  id                String               @id @default(cuid())
  code              String               @unique
  name              String
  category          KpiCategory
  purpose           String?              @db.Text
  formula           String?              @db.Text
  unit              String               @default("%")
  direction         MeasurementDirection @default(HIGHER_BETTER)
  dataSource        String?
  frequency         ReportingFrequency   @default(MONTHLY)
  weight            Float                @default(0.0)
  baselineValue     Float?               @default(0.0)
  targetValue       Float?               @default(100.0)
  warningThreshold  Float?
  criticalThreshold Float?
  responsiblePerson String?
  scope             String?              @default("ALL")
  isActive          Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  // Relations
  assignments KpiAssignment[]
  targets     KpiTarget[]
  values      KpiValue[]

  @@index([code])
  @@index([category])
  @@index([isActive])
}

model KpiPeriod {
  id           String             @id @default(cuid())
  title        String
  year         Int
  periodType   ReportingFrequency @default(MONTHLY)
  campusId     String?
  status       KpiPeriodStatus    @default(DRAFT)
  overallScore Float?
  createdById  String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  // Relations
  targets      KpiTarget[]
  values       KpiValue[]
  approvalLogs KpiApprovalLog[]
  unlockLogs   KpiUnlockLog[]

  @@index([year])
  @@index([status])
  @@index([campusId])
}

model KpiAssignment {
  id          String     @id @default(cuid())
  kpiId       String
  assigneeId  String?
  campusId    String?
  weight      Float      @default(0.0)
  targetValue Float      @default(100.0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  kpi KpiCatalog @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@index([kpiId])
}

model KpiTarget {
  id          String     @id @default(cuid())
  periodId    String
  kpiId       String
  targetValue Float      @default(100.0)
  weight      Float      @default(0.0)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  period KpiPeriod  @relation(fields: [periodId], references: [id], onDelete: Cascade)
  kpi    KpiCatalog @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([periodId, kpiId])
  @@index([periodId])
  @@index([kpiId])
}

model KpiValue {
  id             String     @id @default(cuid())
  periodId       String
  kpiId          String
  actualValue    Float      @default(0.0)
  completionRate Float      @default(0.0)
  weightedScore  Float      @default(0.0)
  notes          String?    @db.Text
  createdById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  // Relations
  period   KpiPeriod     @relation(fields: [periodId], references: [id], onDelete: Cascade)
  kpi      KpiCatalog    @relation(fields: [kpiId], references: [id], onDelete: Cascade)
  evidence KpiEvidence[]

  @@unique([periodId, kpiId])
  @@index([periodId])
  @@index([kpiId])
}

model KpiEvidence {
  id          String   @id @default(cuid())
  kpiValueId  String
  title       String
  fileUrl     String?
  description String?  @db.Text
  createdAt   DateTime @default(now())

  // Relations
  kpiValue KpiValue @relation(fields: [kpiValueId], references: [id], onDelete: Cascade)

  @@index([kpiValueId])
}

model KpiApprovalLog {
  id           String          @id @default(cuid())
  periodId     String
  action       String
  fromStatus   KpiPeriodStatus
  toStatus     KpiPeriodStatus
  reviewerId   String?
  reviewerName String?
  comments     String?         @db.Text
  createdAt    DateTime        @default(now())

  // Relations
  period KpiPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([createdAt])
}

model KpiUnlockLog {
  id             String   @id @default(cuid())
  periodId       String
  requestedById  String?
  requestedByName String?
  reason         String   @db.Text
  approvedById   String?
  approvedByName String?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  period KpiPeriod @relation(fields: [periodId], references: [id], onDelete: Cascade)

  @@index([periodId])
  @@index([status])
}

// ==================== MỤC TIÊU CHẤT LƯỢNG (QUALITY OBJECTIVES) ====================

enum QualityCategory {
  ACADEMIC                  // 1. Chất lượng học tập
  CONDUCT                   // 2. Phẩm chất và năng lực học sinh
  ATTENDANCE                // 3. Chuyên cần
  PROGRAM_COMPLETION        // 4. Tỷ lệ hoàn thành chương trình
  EXCELLENT_STUDENTS        // 5. Học sinh giỏi
  SUPPORT_STUDENTS          // 6. Học sinh cần hỗ trợ
  TEACHER_QUALITY           // 7. Chất lượng đội ngũ
  DIGITAL_TRANSFORMATION    // 8. Chuyển đổi số
  FACILITIES                // 9. Cơ sở vật chất
  SCHOOL_SAFETY             // 10. An toàn trường học
  PARENT_SATISFACTION       // 11. Sự hài lòng của cha mẹ học sinh
  OTHER                     // 12. Mục tiêu khác
}

enum QualityObjectiveStatus {
  EXCEEDED          // Vượt mục tiêu
  ACHIEVED          // Đạt
  NEAR_TARGET       // Gần đạt (80% - <100%)
  AT_RISK           // Có nguy cơ không đạt (60% - <80%)
  FAILED            // Không đạt (<60%)
  NO_DATA           // Chưa có dữ liệu
}

model QualityObjective {
  id                  String                 @id @default(cuid())
  code                String                 @unique
  title               String
  category            QualityCategory        @default(ACADEMIC)
  metricName          String                 // Chỉ số đo lường
  unit                String                 @default("%")
  baselineValue       Float?                 @default(0.0)
  targetValue         Float                  @default(100.0)
  actualValue         Float?                 @default(0.0)
  direction           MeasurementDirection   @default(HIGHER_BETTER)
  minRange            Float?
  maxRange            Float?
  deadline            DateTime?
  period              ReportingFrequency     @default(SEMESTER)
  responsiblePerson   String?
  dataSource          String?                // Nguồn dữ liệu kiểm chứng
  reportingFrequency  ReportingFrequency     @default(MONTHLY)
  campusScope         String                 @default("ALL") // ALL hoặc campusId
  academicYear        String                 @default("2026-2027")
  status              QualityObjectiveStatus @default(NO_DATA)
  completionRate      Float                  @default(0.0)
  actionPlan          String?                @db.Text
  campusBreakdownJson String?                @db.Text // JSON chi tiết theo phân hiệu
  notes               String?                @db.Text
  createdById         String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  // Relations
  evidences QualityObjectiveEvidence[]
  histories QualityObjectiveHistory[]

  @@index([code])
  @@index([category])
  @@index([status])
  @@index([academicYear])
  @@index([campusScope])
}

// ==================== QUY TRÌNH PHÊ DUYỆT & KHÓA DỮ LIỆU ====================

model ApprovalWorkflow {
  id              String            @id @default(cuid())
  schoolId        String?
  moduleName      String            // VD: "STRATEGY_KPI", "QUALITY_OBJECTIVE", "LESSON_PLAN", "MONTHLY_PLAN"
  recordId        String            // ID của record trong module tương ứng
  title           String            // Tên hồ sơ / mục tiêu / kế hoạch
  campusId        String?
  currentStep     Int               @default(1) // 1: Draft, 2: Submitted, 3: Campus Confirmed, 4: VP Reviewed, 5: Principal Approved, 6: Locked
  currentStatus   String            @default("DRAFT") // DRAFT, SUBMITTED, CAMPUS_CONFIRMED, VP_REVIEWED, PRINCIPAL_APPROVED, LOCKED, REJECTED, EDIT_REQUESTED, UNLOCK_REQUESTED
  submittedBy     String?
  submittedByName String?
  submittedAt     DateTime?
  reviewedBy      String?
  reviewedByName  String?
  reviewedAt      DateTime?
  approvedBy      String?
  approvedByName  String?
  approvedAt      DateTime?
  rejectionReason String?           @db.Text
  isLocked        Boolean           @default(false)
  lockedAt        DateTime?
  version         Int               @default(1)
  dueDate         DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  comments ApprovalComment[]

  @@index([moduleName, recordId])
  @@index([currentStatus])
  @@index([campusId])
  @@index([isLocked])
}

model ApprovalComment {
  id             String           @id @default(cuid())
  workflowId     String
  userId         String?
  userName       String?
  userRole       String?
  commentType    String           @default("COMMENT") // COMMENT, REJECT, REQUEST_EDIT, APPROVE, UNLOCK_REQUEST
  commentContent String           @db.Text
  attachmentUrl  String?
  createdAt      DateTime         @default(now())

  workflow ApprovalWorkflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([createdAt])
}

// ==================== TỆP MINH CHỨNG & NHẬT KÝ FILE ====================

model SystemEvidenceFile {
  id             String          @id @default(cuid())
  fileName       String
  fileType       String          // pdf, docx, xlsx, png, jpg, jpeg
  fileSize       Int             // Kích thước (bytes)
  fileUrl        String          @db.Text
  uploadedById   String?
  uploadedByName String          @default("Cán bộ quản lý")
  relatedModule  String          // VD: "QUALITY_OBJECTIVE", "STRATEGY_KPI", "FIVE_YEAR_PLAN"
  relatedRecordId String?        // ID mục tiêu hoặc KPI liên quan
  relatedContent String?         @db.Text // Tên mục tiêu / nội dung liên quan
  campusId       String?
  description    String?         @db.Text
  version        Int             @default(1)
  status         String          @default("ACTIVE") // ACTIVE, REPLACED, DELETED
  isDeleted      Boolean         @default(false) // Xóa mềm
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  auditLogs FileAuditLog[]

  @@index([relatedModule])
  @@index([campusId])
  @@index([isDeleted])
  @@index([createdAt])
}

model FileAuditLog {
  id         String             @id @default(cuid())
  fileId     String
  action     String             // UPLOAD, REPLACE, SOFT_DELETE, RESTORE, DOWNLOAD
  performedById String?
  performedByName String        @default("Hệ thống")
  detail     String?            @db.Text
  createdAt  DateTime           @default(now())

  file SystemEvidenceFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([fileId])
  @@index([createdAt])
}

model QualityObjectiveEvidence {
  id          String   @id @default(cuid())
  objectiveId String
  title       String
  fileUrl     String?
  uploadedBy  String?
  description String?  @db.Text
  createdAt   DateTime @default(now())

  // Relations
  objective QualityObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([objectiveId])
}

model QualityObjectiveHistory {
  id             String                 @id @default(cuid())
  objectiveId    String
  updatedByName  String?
  previousActual Float?
  newActual      Float
  completionRate Float
  status         QualityObjectiveStatus @default(NO_DATA)
  note           String?                @db.Text
  createdAt      DateTime               @default(now())

  // Relations
  objective QualityObjective @relation(fields: [objectiveId], references: [id], onDelete: Cascade)

  @@index([objectiveId])
  @@index([createdAt])
}

// ==================== NHẬT KÝ KIỂM TOÁN & BẢO MẬT (AUDIT LOG) ====================

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
  EXPORT
  IMPORT
  APPROVE
  REJECT
  LOCK
  UNLOCK
  PASSWORD_CHANGE
}

model AuditLog {
  id            String      @id @default(cuid())
  userId        String?     // ID người thao tác
  userName      String?     // Họ tên người thao tác
  userRole      String?     // Vai trò (ADMIN, TEACHER, STUDENT...)
  schoolId      String?     // Trường học liên quan
  campusId      String?     // Phân hiệu liên quan
  action        AuditAction // Loại hành động
  entityName    String      // Tên bảng dữ liệu (e.g. "Student", "Grade", "LessonPlan")
  entityId      String?     // ID bản ghi bị tác động
  description   String?     @db.Text // Mô tả ngắn hành động
  changesJson   String?     @db.Text // JSON dữ liệu trước/sau khi thay đổi
  ipAddress     String?     // Địa chỉ IP người dùng
  userAgent     String?     @db.Text // Trình duyệt / thiết bị
  createdAt     DateTime    @default(now())

  @@index([userId])
  @@index([schoolId])
  @@index([action])
  @@index([entityName])
  @@index([createdAt])
}

model ParticipationRecord {
  id          String   @id @default(cuid())
  studentId   String
  classId     String
  date        DateTime @default(now())
  title       String   // VD: "Phát biểu tích cực", "Giúp đỡ bạn học", "Bài tập hoàn thành xuất sắc"
  category    String   @default("PHAT_BIEU") // PHAT_BIEU, HO_TRO_BAN, VAN_THE, BAI_TAP, PHONG_TRAO
  points      Int      @default(1) // Số điểm thưởng cộng (+1, +2, +5...)
  note        String?  @db.Text
  createdById String?
  createdAt   DateTime @default(now())

  // Relations
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classRoom ClassRoom @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([classId])
  @@index([date])
}

// ==================== KHÓA SỔ DỮ LIỆU (DATA LOCK) ====================

model DataLock {
  id          String   @id @default(cuid())
  schoolId    String
  campusId    String?
  lockType    String   // "GRADE_HK1", "GRADE_HK2", "ATTENDANCE_MONTH_9", "JOURNAL_HK1", etc.
  periodLabel String   // "Học kỳ 1 - 2026-2027", "Tháng 9/2026", etc.
  isLocked    Boolean  @default(false)
  lockedById  String?
  lockedByName String?
  lockedAt    DateTime?
  unlockedById  String?
  unlockedByName String?
  unlockedAt  DateTime?
  reason      String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([schoolId, lockType, periodLabel])
  @@index([schoolId])
  @@index([isLocked])
  @@index([lockType])
}

// ==================== CÀI ĐẶT BẢO MẬT ĐĂNG NHẬP (LOGIN SECURITY) ====================

model LoginAttempt {
  id        String   @id @default(cuid())
  email     String
  ipAddress String?
  success   Boolean  @default(false)
  reason    String?  // "invalid_password", "user_not_found", "locked_account", etc.
  createdAt DateTime @default(now())

  @@index([email])
  @@index([ipAddress])
  @@index([createdAt])
}

// ==================== CẤU HÌNH HỆ THỐNG (SYSTEM SETTINGS) ====================

model SystemSetting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


// ==================== HỌC BẠ ĐIỆN TỬ (ACADEMIC TRANSCRIPT) ====================

enum TranscriptStatus {
  DRAFT
  SUBMITTED
  APPROVED_LOCKED
  UNLOCK_REQUESTED
}

enum UnlockStatus {
  PENDING
  APPROVED
  REJECTED
}

model AcademicTranscript {
  id                     String                  @id @default(cuid())
  studentId              String
  classId                String
  schoolYear             String                  // "2025-2026"
  gradeLevel             Int                     // Khối lớp (6-12)
  status                 TranscriptStatus        @default(DRAFT)

  term1GPA               Float?
  term2GPA               Float?
  fullYearGPA            Float?

  term1Conduct           ConductRating?
  term2Conduct           ConductRating?
  fullYearConduct        ConductRating?

  term1Academic          AcademicRating?
  term2Academic          AcademicRating?
  fullYearAcademic       AcademicRating?

  homeroomTeacherComment String?                 @db.Text
  promotionStatus        String?                 // "Lên lớp", "Thi lại", "Ở lại lớp", "Hoàn thành CT"
  rewardsAwarded         String?                 // Khen thưởng

  submittedAt            DateTime?
  submittedById          String?
  approvedAt             DateTime?
  approvedById           String?

  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt

  student                Student                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  classRoom              ClassRoom               @relation(fields: [classId], references: [id], onDelete: Cascade)
  subjectGrades          TranscriptSubjectGrade[]
  unlockRequests         TranscriptUnlockRequest[]

  @@unique([studentId, schoolYear])
  @@index([studentId])
  @@index([classId])
  @@index([status])
}

model TranscriptSubjectGrade {
  id                String             @id @default(cuid())
  transcriptId      String
  subjectId         String
  subjectName       String             // Lưu cố định tên môn
  term1AvgScore     Float?
  term2AvgScore     Float?
  fullYearAvgScore  Float?
  evaluationComment String?            // Nhận xét môn học

  transcript        AcademicTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
  subject           Subject            @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([transcriptId, subjectId])
}

model TranscriptUnlockRequest {
  id            String             @id @default(cuid())
  transcriptId  String
  requestedById String             // Mã ID GVCN
  reason        String             @db.Text
  status        UnlockStatus       @default(PENDING)
  reviewedById  String?            // Mã ID Hiệu trưởng/Admin
  reviewedAt    DateTime?
  reviewNote    String?            @db.Text
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  transcript    AcademicTranscript @relation(fields: [transcriptId], references: [id], onDelete: Cascade)
}

// ==================== AI ASSISTANT & MULTI-CAMPUS MANAGEMENT ====================

enum AiTaskGroup {
  REALTIME_MONITORING       // 1. Giám sát thời gian thực
  COORDINATION_DISPATCH     // 2. Điều phối hoạt động & dạy thay
  DECISION_SUPPORT          // 3. Hỗ trợ ra quyết định
  PLAN_PROGRESS             // 4. Quản lý kế hoạch & chỉ tiêu
  DOCS_PERIODIC_REPORTS     // 5. Quản lý văn bản & báo cáo định kỳ
  EARLY_WARNING             // 6. Cảnh báo sớm
  COMMUNICATION_FEEDBACK    // 7. Giao tiếp & phản hồi phụ huynh
}

enum AiAlertSeverity {
  INFO
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AiAlertStatus {
  ACTIVE
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
}

enum DocumentType {
  INCOMING           // Công văn đến từ Sở/Phòng/UBND
  OUTGOING           // Công văn đi
  INTERNAL_DIRECTIVE // Chỉ đạo nội bộ nhà trường
}

enum DocumentUrgency {
  NORMAL
  URGENT             // Khẩn
  EXPRESS            // Thượng khẩn / Hỏa tốc
}

enum DocumentStatus {
  PENDING
  PROCESSING
  COMPLETED
  OVERDUE
}

enum EquipmentCategory {
  IT_COMPUTER        // Máy vi tính / Phòng tin học
  PROJECTOR_SCREEN   // Máy chiếu / Màn hình tương tác
  LAB_PHYSICS        // Thiết bị thí nghiệm Vật lý
  LAB_CHEMISTRY      // Thiết bị thí nghiệm Hóa học
  LAB_BIOLOGY        // Thiết bị thí nghiệm Sinh học
  SPORTS             // Thiết bị thể dục thể thao
  MUSIC_ARTS         // Nhạc cụ, Mỹ thuật
  GENERAL            // Thiết bị dùng chung
}

enum EquipmentCondition {
  EXCELLENT
  GOOD
  FAIR
  POOR
  BROKEN
}

enum TransferStatus {
  PENDING
  APPROVED
  IN_TRANSIT
  COMPLETED
  CANCELLED
}

// 1. Bảng Cấu hình Ngưỡng cảnh báo thông minh (Configurable Thresholds)
model AiConfigThreshold {
  id               String          @id @default(cuid())
  schoolId         String
  taskGroup        AiTaskGroup
  metricKey        String          // VD: "MAX_ABSENT_DAYS_MONTH", "TEACHER_SHORTAGE_THRESHOLD", "SYLLABUS_DELAY_DAYS"
  metricName       String          // Tên hiển thị tiếng Việt
  thresholdValue   Float           // Giá trị ngưỡng (VD: 3 buổi, 1 giáo viên, 7 ngày)
  comparisonOp     String          @default("GTE") // GTE, LTE, EQ, NEQ
  severity         AiAlertSeverity @default(MEDIUM)
  description      String?         @db.Text
  isEditable       Boolean         @default(true)
  updatedAt        DateTime        @updatedAt
  createdAt        DateTime        @default(now())

  school           School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, metricKey])
  @@index([schoolId])
  @@index([taskGroup])
}

// 2. Bảng Lưu trữ Cảnh báo AI theo Điểm trường
model AiAlert {
  id               String          @id @default(cuid())
  schoolId         String
  campusId         String?
  schoolPointId    String?
  taskGroup        AiTaskGroup
  severity         AiAlertSeverity
  status           AiAlertStatus   @default(ACTIVE)
  title            String
  description      String          @db.Text
  triggerMetric    String?         // Số liệu thực tế kích hoạt cảnh báo (VD: "Vắng 4 buổi trong tháng 8/2026")
  suggestedAction  String?         @db.Text
  impactAnalysis   String?         @db.Text
  targetEntity     String?         // "Student:cuid", "Teacher:cuid", "ClassRoom:cuid"
  targetName       String?         // Tên đối tượng liên quan để hiển thị trực tiếp
  acknowledgedById String?
  acknowledgedAt   DateTime?
  resolvedById     String?
  resolvedAt       DateTime?
  resolutionNote   String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  school           School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus           Campus?         @relation(fields: [campusId], references: [id], onDelete: SetNull)
  schoolPoint      SchoolPoint?    @relation(fields: [schoolPointId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([campusId])
  @@index([taskGroup])
  @@index([severity])
  @@index([status])
  @@index([createdAt])
}

// 3. Bảng Lưu trữ Đề xuất & Phương án Tư vấn của AI
model AiRecommendation {
  id                String          @id @default(cuid())
  schoolId          String
  campusId          String?
  schoolPointId     String?
  taskGroup         AiTaskGroup
  title             String
  contextSummary    String          @db.Text
  optionsJson       String          @db.Text // JSON: Array<{ title, pros: [], cons: [], score: number, feasibility: string }>
  recommendedOption String?
  legalGrounds      String?         @db.Text // Căn cứ pháp lý: Thông tư, Điều lệ trường học
  actionStepsJson   String?         @db.Text // JSON: string[]
  isApplied         Boolean         @default(false)
  appliedAt         DateTime?
  appliedById       String?
  appliedNotes      String?         @db.Text
  createdAt         DateTime        @default(now())

  school            School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus            Campus?         @relation(fields: [campusId], references: [id], onDelete: SetNull)
  schoolPoint       SchoolPoint?    @relation(fields: [schoolPointId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([campusId])
  @@index([taskGroup])
}

// 4. Bảng Lưu trữ Báo cáo Tổng hợp Định kỳ của AI
model AiReportSummary {
  id                 String      @id @default(cuid())
  schoolId           String
  campusId           String?     // Null = Toàn trường, Có ID = Điểm trường cụ thể
  reportType         String      // "DAILY_EXECUTIVE", "WEEKLY_CAMPUS_AUDIT", "MONTHLY_STRATEGIC"
  periodLabel        String      // "Ngày 31/08/2026", "Tuần 35/2026", "Tháng 8/2026"
  contentJson        String      @db.Text // JSON tổng hợp chi tiết theo 4 điểm trường
  aiExecutiveSummary String      @db.Text // Tóm tắt điều hành 1 đoạn dành cho Hiệu trưởng
  createdAt          DateTime    @default(now())

  school             School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus             Campus?     @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([campusId])
  @@index([reportType])
}

// 5. Bảng Nhật ký Phân tích & Vận hành Pipeline AI
model AiAnalysisLog {
  id              String       @id @default(cuid())
  schoolId        String
  campusId        String?
  triggeredBy     String       // "MANUAL_PRINCIPAL", "SCHEDULED_CRON", "WEBHOOK"
  taskGroup       AiTaskGroup?
  status          String       // "SUCCESS", "WARNING", "FAILED"
  alertsGenerated Int          @default(0)
  durationMs      Int          @default(0)
  detailsJson     String?      @db.Text
  createdAt       DateTime     @default(now())

  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([createdAt])
}

// 6. Quản lý Công văn & Văn bản chỉ đạo
model OfficialDocument {
  id              String          @id @default(cuid())
  schoolId        String
  campusId        String?
  docNumber       String          // Số/Ký hiệu văn bản (e.g. "124/SGDĐT-GDTrH")
  title           String          // Trích yếu nội dung
  issuer          String          // Cơ quan ban hành (Sở GD&ĐT, Phòng GD&ĐT, UBND Xã...)
  issueDate       DateTime
  receivedDate    DateTime        @default(now())
  deadline        DateTime?       // Hạn xử lý / báo cáo
  docType         DocumentType    @default(INCOMING)
  urgency         DocumentUrgency @default(NORMAL)
  status          DocumentStatus  @default(PENDING)
  summary         String?         @db.Text
  actionRequired  String?         @db.Text // Nội dung yêu cầu thực hiện
  assignedToId    String?         // Người phụ trách xử lý
  assignedToName  String?
  fileUrl         String?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  school          School          @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus          Campus?         @relation(fields: [campusId], references: [id], onDelete: SetNull)

  @@index([schoolId])
  @@index([campusId])
  @@index([deadline])
  @@index([status])
  @@index([urgency])
}

// 7. Quản lý Thiết bị & Đồ dùng dạy học
model Equipment {
  id                String             @id @default(cuid())
  schoolId          String
  campusId          String?
  schoolPointId     String?
  code              String             @unique
  name              String
  category          EquipmentCategory  @default(GENERAL)
  totalQuantity     Int                @default(1)
  availableQuantity Int                @default(1)
  inUseQuantity     Int                @default(0)
  brokenQuantity    Int                @default(0)
  condition         EquipmentCondition @default(GOOD)
  unit              String             @default("bộ")
  locationDetail    String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  school            School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus            Campus?             @relation(fields: [campusId], references: [id], onDelete: SetNull)
  schoolPoint       SchoolPoint?        @relation(fields: [schoolPointId], references: [id], onDelete: SetNull)
  transfersFrom     EquipmentTransfer[] @relation("TransferEquipment")

  @@index([schoolId])
  @@index([campusId])
  @@index([schoolPointId])
  @@index([category])
}

// 8. Điều chuyển thiết bị giữa các điểm trường
model EquipmentTransfer {
  id                 String         @id @default(cuid())
  schoolId           String
  equipmentId        String
  fromSchoolPointId  String?
  toSchoolPointId    String
  quantity           Int            @default(1)
  transferDate       DateTime       @default(now())
  returnExpectedDate DateTime?
  actualReturnDate   DateTime?
  reason             String         @db.Text
  status             TransferStatus @default(PENDING)
  approvedById       String?
  aiRecommendation   String?        @db.Text
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  equipment          Equipment      @relation("TransferEquipment", fields: [equipmentId], references: [id], onDelete: Cascade)
  fromSchoolPoint    SchoolPoint?   @relation("TransferSourcePoint", fields: [fromSchoolPointId], references: [id], onDelete: SetNull)
  toSchoolPoint      SchoolPoint    @relation("TransferTargetPoint", fields: [toSchoolPointId], references: [id], onDelete: Cascade)

  @@index([schoolId])
  @@index([equipmentId])
  @@index([fromSchoolPointId])
  @@index([toSchoolPointId])
  @@index([status])
}

// ==================== MODULE HÀNH TRÌNH HỌC SINH (STUDENT LEARNING JOURNEY) ====================

enum ExamSemester {
  HK1
  HK2
}

enum ExamType {
  ORAL
  FIFTEEN_MIN
  MIDTERM
  FINAL
  PERIOD_SUMMARY
}

enum MatchConfidence {
  EXACT
  FUZZY
  MANUAL_REVIEW
}

enum ImportBatchStatus {
  STAGED
  MAPPED
  REVIEWED
  COMMITTED
  ROLLED_BACK
}

enum TrendLabel {
  IMPROVING
  STABLE
  DECLINING
  VOLATILE
}

enum TriggerSource {
  AI
  TEACHER
  ADMIN
}

enum InterventionStatus {
  SUGGESTED
  APPROVED
  APPLIED
  OUTCOME_TRACKED
  REJECTED
}

model ExamPeriod {
  id           String       @id @default(cuid())
  schoolId     String
  campusId     String?
  schoolYear   String       // VD: "2024-2025", "2025-2026"
  semester     ExamSemester // HK1, HK2
  examType     ExamType     // MIDTERM, FINAL, PERIOD_SUMMARY...
  name         String       // "Giữa kỳ 1 2025-2026"
  orderIndex   Int          // Thứ tự thời gian tuyệt đối (1, 2, 3, 4...) để hồi quy tuyến tính chạy chính xác
  startDate    DateTime?
  endDate      DateTime?
  isLocked     Boolean      @default(false)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  school       School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus       Campus?      @relation(fields: [campusId], references: [id], onDelete: SetNull)
  scores       StudentScore[]
  snapshots    StudentJourneySnapshot[]

  @@unique([schoolId, schoolYear, semester, examType])
  @@index([schoolId])
  @@index([campusId])
  @@index([orderIndex])
}

model StudentScore {
  id            String      @id @default(cuid())
  studentId     String
  subjectId     String
  examPeriodId  String
  schoolId      String
  campusId      String
  score         Float       // 0.0 - 10.0
  importBatchId String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  student       Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject       Subject     @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examPeriod    ExamPeriod  @relation(fields: [examPeriodId], references: [id], onDelete: Cascade)
  school        School      @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus        Campus      @relation(fields: [campusId], references: [id], onDelete: Cascade)
  importBatch   StudentImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)

  @@unique([studentId, subjectId, examPeriodId])
  @@index([studentId])
  @@index([subjectId])
  @@index([examPeriodId])
  @@index([schoolId, campusId])
}

model StudentImportBatch {
  id             String            @id @default(cuid())
  schoolId       String
  campusId       String?
  fileName       String
  totalRows      Int               @default(0)
  validRows      Int               @default(0)
  invalidRows    Int               @default(0)
  status         ImportBatchStatus @default(STAGED)
  importedById   String
  importedByName String?
  committedAt    DateTime?
  rolledBackAt   DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  school         School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  stagings       StudentImportStaging[]
  mappings       StudentImportMapping[]
  scores         StudentScore[]

  @@index([schoolId])
  @@index([campusId])
  @@index([status])
}

model StudentImportStaging {
  id             String   @id @default(cuid())
  batchId        String
  rowNumber      Int
  rawStudentCode String?
  rawName        String
  rawClassLabel  String?
  rawSubject     String
  rawPeriod      String
  rawScore       Float?
  isValid        Boolean  @default(true)
  errorMessage   String?  @db.Text
  createdAt      DateTime @default(now())

  batch          StudentImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
}

model StudentImportMapping {
  id               String          @id @default(cuid())
  batchId          String
  rawName          String
  rawStudentCode   String?
  rawClassLabel    String?
  rawSubject       String?
  matchedStudentId String?
  matchedSubjectId String?
  matchedPeriodId  String?
  matchConfidence  MatchConfidence
  reviewedBy       String?
  reviewedByName   String?
  reviewedAt       DateTime?
  notes            String?         @db.Text
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  batch            StudentImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([matchConfidence])
}

model JourneyThresholdConfig {
  id                 String   @id @default(cuid())
  schoolId           String
  campusId           String
  increasingSlope    Float    @default(0.25)
  decliningSlope     Float    @default(0.25)
  volatilityMax      Float    @default(1.2)
  minPeriodsRequired Int      @default(3)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  school             School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus             Campus   @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@unique([schoolId, campusId])
  @@index([schoolId])
  @@index([campusId])
}

model StudentJourneySnapshot {
  id                 String     @id @default(cuid())
  studentId          String
  subjectId          String?
  examPeriodId       String
  schoolId           String
  campusId           String

  avgScore           Float
  trendSlope         Float
  trendLabel         TrendLabel
  volatilityScore    Float
  baselineScore      Float
  deltaFromBaseline  Float
  dataPointsCount    Int        @default(0)
  isInsufficientData Boolean    @default(false)

  computedAt         DateTime   @default(now())

  student            Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  subject            Subject?   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  examPeriod         ExamPeriod @relation(fields: [examPeriodId], references: [id], onDelete: Cascade)
  school             School     @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  campus             Campus     @relation(fields: [campusId], references: [id], onDelete: Cascade)

  @@index([studentId, examPeriodId])
  @@index([schoolId, campusId, trendLabel])
  @@index([computedAt])
}

model InterventionRecord {
  id                  String             @id @default(cuid())
  studentId           String
  schoolId            String
  campusId            String
  subjectId           String?
  triggeredBy         TriggerSource
  trendLabelAtTrigger TrendLabel
  interventionType    String
  note                String?            @db.Text
  status              InterventionStatus @default(SUGGESTED)

  suggestedAt         DateTime           @default(now())
  approvedById        String?
  approvedByName      String?
  approvedAt          DateTime?
  rejectionReason     String?            @db.Text
  rejectedAt          DateTime?
  appliedById         String?
  appliedByName       String?
  appliedAt           DateTime?

  outcomeCheckedAt    DateTime?
  outcomeScoreDelta   Float?
  outcomeNote         String?            @db.Text

  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  student             Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@index([schoolId, campusId])
  @@index([status])
  @@index([triggeredBy])
}
